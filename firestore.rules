rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /runs/{runId} {
      // Anyone can see the leaderboard.
      allow read: if true;

      // Anyone can post a finished run, but only in this exact shape.
      allow create: if request.resource.data.keys().hasOnly(['name', 'secs', 'day', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 16
        && request.resource.data.secs is int
        && request.resource.data.secs >= 25
        && request.resource.data.secs <= 3600
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && request.resource.data.at == request.time;

      // Nobody edits a posted time.
      allow update: if false;

      // Only booth staff can remove entries. Paste your staff account's
      // User UID below (README, step 4).
      allow delete: if request.auth != null
        && request.auth.uid in ['PASTE_STAFF_UID'];
    }
  }
}
